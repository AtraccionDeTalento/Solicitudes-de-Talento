rules_version = '2';
// Modelo: los jefes entran con nombre y correo @usil.edu.pe (sesión anónima de Firebase; el correo NO se verifica): pueden crear solicitudes y leer
// solo las suyas. HRBP y Gerencia entran con correo y clave: su rol vive en roles/{correo}. El Maestro (datos de personas) solo se abre a los
// jefes sin verificar mientras config/app.modoPrueba sea true; en producción solo lo leen HRBP y Gerencia.
service cloud.firestore {
  match /databases/{db}/documents {
    function dominioOk(e) { return e.matches('[^@]+@(usil[.]edu[.]pe|usil[.]pe|epg[.]usil[.]pe|sir[.]pe|sir[.]edu[.]pe|institutoemprendedores[.]pe|institutoemprendedores[.]edu[.]pe)'); }   // dominios de USIL y sus unidades (el correo debe estar verificado)
    function usil() { return request.auth != null && request.auth.token.email_verified == true && dominioOk(request.auth.token.email); }
    function personal() { return usil() && request.auth.token.firebase.sign_in_provider == 'password'; }
    // Los jefes ahora entran con correo institucional VERIFICADO y clave (personal()). El acceso anónimo anterior (nombre y correo sin verificar) queda apagado
    // salvo que config/app.accesoAnonimo sea true (solo para migrar o probar).
    function anonimoOk() { return anonimo() && get(/databases/$(db)/documents/config/app).data.get('accesoAnonimo', false) == true; }
    function staff() { return personal() && exists(/databases/$(db)/documents/roles/$(yo())); }   // HRBP o Gerencia (con rol asignado)
    function anonimo() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function prueba() { return get(/databases/$(db)/documents/config/app).data.modoPrueba == true; }
    function bpDe() { return get(/databases/$(db)/documents/roles/$(yo())).data.bpId; }
    function yo() { return 'email' in request.auth.token ? request.auth.token.email : '-'; }
    // Quien pide es el JEFE de área. Un socio de negocio al que se le marcó «pideComoJefe: false» en su rol (las socias de negocio) no crea solicitudes, ni con su cuenta del panel
    // ni con el alias usuario+jefe@. El resto (jefes de área; también el Subgerente de Talento, que tiene rol de socio pero es jefatura) pide con normalidad.
    function puedePedir() { let base = yo().replace('[+]jefe@', '@'); return !exists(/databases/$(db)/documents/roles/$(base)) || get(/databases/$(db)/documents/roles/$(base)).data.get('pideComoJefe', true) == true; }
    function tieneRol(r) {
      return personal() && exists(/databases/$(db)/documents/roles/$(yo()))
        && r in get(/databases/$(db)/documents/roles/$(yo())).data.roles;
    }

    match /roles/{correo} { allow get: if personal() && correo == yo(); }
    // El ruteo solo trae un identificador opaco (bpId): ni nombres ni correos de los Business Partner son legibles por un jefe.
    match /ruteo/{dep}    { allow get: if personal() || anonimoOk(); }
    match /bps/{id}       { allow get, list: if staff(); }   // bpId → nombre, solo para HRBP y Gerencia
    // Búsqueda del colaborador por correo (autorrelleno). Para los jefes sin verificar solo se abre en modo prueba o si config/app.busquedaJefes = true:
    // con ella cualquiera podría probar correos y ver nombre y puesto de esa persona, así que se enciende a conciencia (y junto con App Check).
    match /colaboradores/{correo} { allow get: if personal() || (anonimoOk() && (prueba() || get(/databases/$(db)/documents/config/app).data.get('busquedaJefes', false) == true)); }
    // Cortes de Gerencia: copia congelada de los casos que se llevan a un comité. Solo Gerencia los lee y los crea; nadie los edita ni los borra (historial).
    match /cortes/{id} {
      allow get, list: if tieneRol('gerencia');
      allow create: if tieneRol('gerencia') && request.resource.data.keys().hasOnly(['titulo', 'nota', 'fechaCorte', 'creadoPor', 'creadoEl', 'casos', 'resumen'])
        && request.resource.data.creadoPor == yo() && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 120
        && request.resource.data.casos is list && request.resource.data.casos.size() > 0 && request.resource.data.casos.size() <= 100
        && (!('nota' in request.resource.data) || request.resource.data.nota.size() <= 1000);
      allow update, delete: if false;
    }
    // Trazabilidad: cada gestión (devolver, pausar, derivar, escalar, aprobar, rechazar, comentar) deja un evento que nadie edita ni borra.
    // Solo se crea si coincide con lo que la propia persona acaba de hacer en la solicitud (mismo estado, mismo socio de negocio, firmado por ella).
    // La solicitud y su evento se escriben en el MISMO lote (por eso se valida contra getAfter: lo que la solicitud será al terminar el lote): o queda todo o no queda nada.
    match /eventos/{id} {
      allow get, list: if tieneRol('gerencia') || (tieneRol('bp') && resource.data.bpId == bpDe())
        || (tieneRol('bp') && get(/databases/$(db)/documents/solicitudes/$(resource.data.solicitudId)).data.bpId == bpDe());   // el HRBP que recibe una derivación ve también el historial anterior (se consulta por solicitudId)
      allow create: if (tieneRol('bp') || tieneRol('gerencia'))
        && request.resource.data.keys().hasOnly(['solicitudId', 'bpId', 'tipo', 'de', 'a', 'por', 'rol', 'fecha', 'comentario'])
        && request.resource.data.por == yo()
        && existsAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId))
        && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.gestionadoPor == yo() && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.estado == request.resource.data.a && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.bpId == request.resource.data.bpId
        && (!('comentario' in request.resource.data) || request.resource.data.comentario.size() <= 1000);
      allow update, delete: if false;
    }
    // Seguimiento que ve el JEFE: la misma historia que «eventos» pero SIN correos ni nombres de los socios de negocio (solo el rol), porque los jefes no deben conocerlos.
    // Lo escribe quien gestiona, en el mismo lote que la solicitud; lo lee el dueño de la solicitud. Nadie lo edita ni lo borra.
    match /trazas/{id} {
      allow get, list: if (personal() || anonimo()) && resource.data.uid == request.auth.uid;
      allow create: if (tieneRol('bp') || tieneRol('gerencia'))
        && request.resource.data.keys().hasOnly(['solicitudId', 'uid', 'tipo', 'de', 'a', 'rol', 'fecha', 'comentario'])
        && request.resource.data.rol in ['bp', 'gerencia']
        && existsAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId))
        && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.gestionadoPor == yo()
        && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.estado == request.resource.data.a
        && getAfter(/databases/$(db)/documents/solicitudes/$(request.resource.data.solicitudId)).data.uid == request.resource.data.uid
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
        && (!('comentario' in request.resource.data) || request.resource.data.comentario.size() <= 1000);
      allow update, delete: if false;
    }
    // Un socio de negocio o Gerencia que también pide como jefe usa una cuenta aparte «usuario+jefe@usil.edu.pe» (clave = su DNI); lee los datos de su correo base.
    match /lideres/{correo} { allow get: if personal() && (correo == yo() || correo == yo().replace('[+]jefe@', '@')); }
    match /maestro/{mat} {
      // En modo prueba cualquier jefe verificado puede usar el relleno de pruebas (persona al azar); en producción solo el personal con rol.
      allow get: if staff() || ((personal() || anonimoOk()) && prueba());
      allow list: if (staff() || ((personal() || anonimoOk()) && prueba())) && request.query.limit <= 50 && prueba();
    }

    match /solicitudes/{id} {
      // ponytail: sin Cloud Functions no hay límite de envíos por usuario; si hace falta, activar App Check o pasar a plan Blaze.
      allow create: if ((personal() && request.resource.data.enviadoPor == yo() && puedePedir()) || (anonimoOk() && dominioOk(request.resource.data.enviadoPor))) && nueva(id, request.resource.data);
      allow get, list:
        if ((personal() || anonimo()) && resource.data.uid == request.auth.uid)
        || (tieneRol('bp') && resource.data.bpId == bpDe())
        || (tieneRol('gerencia') && resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']);
      allow update:
        if (tieneRol('bp') && resource.data.bpId == bpDe()
          && resource.data.estado in ['Nuevo', 'En revisión BP', 'Devuelto al jefe', 'En pausa']
          && request.resource.data.estado in ['En revisión BP', 'Devuelto al jefe', 'Enviado a Gerencia', 'En pausa']
          && gestion(['comentarioBP', 'textoGerencia', 'textoOrigen', 'bpId', 'derivadoDe', 'presupuestoConfirmado']) && derivacion()
          // «¿hay presupuesto?» lo confirma el HRBP (Sí o No) y es lo único que ve el jefe; el monto vive aparte (solicitudes/{id}/interno/presupuesto). Sin esa confirmación no se escala a Gerencia.
          && request.resource.data.get('presupuestoConfirmado', '') in ['', 'Sí', 'No']
          && (request.resource.data.estado != 'Enviado a Gerencia' || request.resource.data.get('presupuestoConfirmado', '') in ['Sí', 'No']))
        || (tieneRol('gerencia')
          && resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']
          && request.resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado', 'En revisión BP']
          && gestion(['comentarioGerencia']));
    }

    // Capturas de la confirmación del jefe aprobador: JPEG ya comprimido por la app (≤ 400 000 caracteres), escrito una sola vez por el dueño de la solicitud.
    // Las leen el dueño, el Business Partner de la solicitud y Gerencia (solo cuando ya se la pasaron). Nadie las edita ni las borra.
    match /solicitudes/{id}/evidencias/{n} {
      allow create: if personal() && n in ['0', '1', '2'] && request.resource.data.keys().hasOnly(['img', 'uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/solicitudes/$(id)).data.uid == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() > 100 && request.resource.data.img.size() <= 400000
        && request.resource.data.img.matches('data:image/jpeg;base64,.*');
      allow get, list: if (personal() && get(/databases/$(db)/documents/solicitudes/$(id)).data.uid == request.auth.uid)
        || (tieneRol('bp') && get(/databases/$(db)/documents/solicitudes/$(id)).data.bpId == bpDe())
        || (tieneRol('gerencia') && get(/databases/$(db)/documents/solicitudes/$(id)).data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']);
      allow update, delete: if false;
    }

    // Monto del presupuesto: solo lo escribe y lo lee el HRBP de la solicitud; Gerencia lo lee cuando ya se la pasaron. El jefe (dueño de la solicitud) NO lo puede leer: por eso va en un
    // documento aparte y no dentro de la solicitud (un campo dentro del documento lo vería su dueño). Se escribe en el mismo lote que la gestión del HRBP.
    match /solicitudes/{id}/interno/{n} {
      allow create, update: if n == 'presupuesto' && tieneRol('bp') && get(/databases/$(db)/documents/solicitudes/$(id)).data.bpId == bpDe()
        && get(/databases/$(db)/documents/solicitudes/$(id)).data.estado in ['Nuevo', 'En revisión BP', 'Devuelto al jefe', 'En pausa']
        && request.resource.data.keys().hasOnly(['monto', 'nota', 'por', 'fecha']) && request.resource.data.por == yo()
        && request.resource.data.monto is string && request.resource.data.monto.size() <= 60
        && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 300))
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 40;
      allow get, list: if (tieneRol('bp') && get(/databases/$(db)/documents/solicitudes/$(id)).data.bpId == bpDe())
        || (tieneRol('gerencia') && get(/databases/$(db)/documents/solicitudes/$(id)).data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']);
      allow delete: if false;
    }

    // Solo cambian estado, el comentario del rol y quién gestionó.
    function gestion(comentario) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'gestionadoPor', 'gestionadoEl'].concat(comentario))
        && request.resource.data.gestionadoPor == yo()
        && request.resource.data.get(comentario[0], '').size() <= 1000
        && request.resource.data.get('textoGerencia', '').size() <= 20000 && request.resource.data.get('textoOrigen', '').size() <= 30;   // texto redactado para Gerencia (solo lo envía el BP al escalar)
    }

    // Derivar a otro Business Partner: cambian juntos bpId y derivadoDe; el destino debe existir y ser distinto del actual.
    function derivacion() {
      let cambio = request.resource.data.diff(resource.data).affectedKeys();
      return cambio.hasAny(['bpId']) == cambio.hasAny(['derivadoDe'])
        && (!cambio.hasAny(['bpId']) || (request.resource.data.derivadoDe == bpDe() && request.resource.data.bpId != bpDe()
            && exists(/databases/$(db)/documents/bps/$(request.resource.data.bpId)) && request.resource.data.estado == 'En revisión BP'));
    }

    function s(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    function nueva(id, d) {
      let rt = get(/databases/$(db)/documents/ruteo/$(d.departamento)).data;
      return d.id == id && d.uid == request.auth.uid && d.estado == 'Nuevo'
        && d.bpId == rt.bpId && !('bp' in d) && !('bpCorreo' in d)
        && d.comentarioBP == '' && d.comentarioGerencia == '' && !('gestionadoPor' in d)
        && d.enviadoPor.size() < 120
        && d.movimiento in ['Promoción', 'Encargatura', 'Reemplazo', 'Puesto nuevo', 'Incremento salarial', 'Movimiento interno', 'Otro']
        // Solo los campos que envía la app, con tamaños acotados: nadie puede guardar datos ajenos al formulario ni documentos enormes.
        && d.keys().hasOnly(['id', 'enviadoEl', 'enviadoPor', 'origen', 'periodo', 'levantamiento', 'aprobaciones', 'puntaje', 'clasificacion', 'fortalezas', 'alertas', 'recomendacion', 'fechaSolicitud', 'cliente', 'cargoCliente', 'departamento', 'area', 'seccion', 'codigo', 'colaborador', 'puestoActual', 'movimiento', 'tieneAprobacion', 'presupuesto', 'fuentePresupuesto', 'validaPresupuesto', 'montoPresupuesto', 'urgencia', 'impacto', 'consecuencia', 'impactoDetalle', 'solicitudConcreta', 'uid', 'bpId', 'estado', 'comentarioBP', 'comentarioGerencia'])
        && d.keys().hasAll(['id', 'uid', 'bpId', 'estado', 'enviadoPor', 'movimiento', 'departamento', 'impactoDetalle', 'solicitudConcreta', 'comentarioBP', 'comentarioGerencia'])
        && s(d, 'cliente', 200) && s(d, 'cargoCliente', 200) && s(d, 'colaborador', 200) && s(d, 'puestoActual', 200) && s(d, 'area', 200) && s(d, 'seccion', 200) && s(d, 'validaPresupuesto', 200) && s(d, 'clasificacion', 100) && s(d, 'fortalezas', 2000) && s(d, 'alertas', 2000) && s(d, 'recomendacion', 800) && s(d, 'impactoDetalle', 1000) && s(d, 'solicitudConcreta', 3000)
        && s(d, 'origen', 20) && s(d, 'enviadoEl', 40) && s(d, 'fechaSolicitud', 40) && s(d, 'codigo', 60) && s(d, 'tieneAprobacion', 20) && s(d, 'presupuesto', 20) && s(d, 'fuentePresupuesto', 200) && s(d, 'montoPresupuesto', 60) && s(d, 'urgencia', 100) && s(d, 'impacto', 100) && s(d, 'consecuencia', 200) && s(d, 'puntaje', 10)
        && (!('periodo' in d) || (d.periodo is string && d.periodo.matches('20[0-9]{2}-(0[1-9]|1[0-2])')))   // el panel arma meses con el periodo: un valor raro no puede tumbarle la bandeja al Business Partner
        && d.get('levantamiento', []) is list && d.get('levantamiento', []).size() <= 80 && d.get('aprobaciones', []) is list && d.get('aprobaciones', []).size() <= 3
        && (d.get('tieneAprobacion', '') != 'Sí' || (d.get('aprobaciones', []).size() >= 1 && conEvidencia(id, d.get('aprobaciones', []).size())));   // aprobación previa = una captura de la confirmación por cada aprobación
    }

    // Cada aprobación trae su captura (evidencias/0, 1, 2), que debe escribirse en el mismo lote que la solicitud (existsAfter).
    function evExiste(id, i) { return existsAfter(/databases/$(db)/documents/solicitudes/$(id)/evidencias/$(i)); }
    function conEvidencia(id, n) {
      return evExiste(id, '0') && (n < 2 || evExiste(id, '1')) && (n < 3 || evExiste(id, '2'));
    }
  }
}
