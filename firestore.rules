rules_version = '2';
// Modelo: toda persona entra con su DNI, convertido en una cuenta opaca de Firebase (ver dni.mjs). Solo existen cuentas creadas por el
// administrador y solo valen si tienen un documento en lideres/ (jefes) o roles/ (HRBP y Gerencia): una cuenta creada por un tercero no accede a nada.
// No hay correos en la base. El maestro solo se lee por matrícula (get); la lista, únicamente con config/app.modoPrueba = true.
service cloud.firestore {
  match /databases/{db}/documents {
    function yo() { return 'email' in request.auth.token ? request.auth.token.email : '-'; }
    function cuenta() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' && request.auth.token.email_verified == true; }
    function activo() {
      return cuenta() && (exists(/databases/$(db)/documents/lideres/$(yo())) || exists(/databases/$(db)/documents/roles/$(yo())));
    }
    function tieneRol(r) {
      return cuenta() && exists(/databases/$(db)/documents/roles/$(yo()))
        && r in get(/databases/$(db)/documents/roles/$(yo())).data.roles;
    }

    match /roles/{id}   { allow get: if cuenta() && id == yo(); }
    match /lideres/{id} { allow get: if cuenta() && id == yo(); }   // cada quien lee solo su propio registro
    match /ruteo/{dep}  { allow get: if activo(); }
    match /maestro/{mat} {
      allow get: if activo();
      allow list: if activo() && request.query.limit <= 50
        && get(/databases/$(db)/documents/config/app).data.modoPrueba == true;
    }

    match /solicitudes/{id} {
      // ponytail: sin Cloud Functions no hay límite de envíos por persona; si hace falta, activar App Check o pasar a plan Blaze.
      allow create: if activo() && request.resource.data.enviadoPor == yo() && nueva(id, request.resource.data);
      allow get, list: if
        (resource.data.enviadoPor == yo() && activo())
        || (tieneRol('bp') && resource.data.bpCorreo == yo())
        || (tieneRol('gerencia') && resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']);
      allow update:
        if (tieneRol('bp') && resource.data.bpCorreo == yo()
          && resource.data.estado in ['Nuevo', 'En revisión BP', 'Devuelto al jefe', 'En pausa']
          && request.resource.data.estado in ['En revisión BP', 'Devuelto al jefe', 'Enviado a Gerencia', 'En pausa']
          && gestion(['comentarioBP']))
        || (tieneRol('gerencia')
          && resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado']
          && request.resource.data.estado in ['Enviado a Gerencia', 'Aprobado', 'Rechazado', 'En revisión BP']
          && gestion(['comentarioGerencia']));
    }

    // Solo cambian estado, el comentario del rol y quién gestionó.
    function gestion(comentario) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'gestionadoPor', 'gestionadoEl'].concat(comentario))
        && request.resource.data.gestionadoPor == yo()
        && request.resource.data.get(comentario[0], '').size() <= 1000;
    }

    function nueva(id, d) {
      let rt = get(/databases/$(db)/documents/ruteo/$(d.departamento)).data;
      return d.id == id && d.uid == request.auth.uid && d.estado == 'Nuevo'
        && d.bpCorreo == rt.correo && d.bp == rt.nombre
        && d.comentarioBP == '' && d.comentarioGerencia == '' && !('gestionadoPor' in d)
        && d.movimiento in ['Promoción', 'Encargatura', 'Reemplazo', 'Puesto nuevo', 'Incremento salarial', 'Movimiento lateral', 'Movimiento horizontal', 'Reestructuración de área', 'Revalorización de puesto', 'Convenio / caso especial', 'Otro']
        && d.impactoDetalle.size() <= 1000 && d.solicitudConcreta.size() <= 3000 && d.keys().size() < 60;
    }
  }
}
